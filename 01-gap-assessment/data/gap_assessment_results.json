 "priority_gaps": [
  {
   "id": "GAP-05",
   "title": "Attacks would go undetected",
   "why": "An intruder could stay for weeks. Longer dwell time means bigger losses, and late discovery undermines regulatory reporting.",
   "what": "Turn on full logging, deploy a SIEM and start daily triage with ATT&CK-mapped detections.",
   "owner": "Nino Beridze",
   "target": "Jun 2027",
   "items": 3,
   "p1": 3,
   "avg": 0.333333333333333,
   "pscore": 9.66666666666667,
   "rank": 1
  },
  {
   "id": "GAP-02",
   "title": "No working risk management",
   "why": "Security money goes wherever the last customer question pointed. Orvanta cannot show the Bank of Lithuania or an auditor why it chose its controls.",
   "what": "Adopt a method and complete a threat-informed risk assessment and treatment plan.",
   "owner": "Lukas Jankauskas",
   "target": "Mar 2027",
   "items": 5,
   "p1": 3,
   "avg": 0.6,
   "pscore": 9,
   "rank": 2
  },
  {
   "id": "GAP-08",
   "title": "Suppliers are unassessed",
   "why": "Critical services run through vendors nobody has assessed. A supplier breach could stop payments and is Orvanta's responsibility to regulators.",
   "what": "Tier all 20 vendors, assess Tier 1 and complete the DORA register of information.",
   "owner": "Eglė Norvilaitė",
   "target": "Jun 2027",
   "items": 5,
   "p1": 3,
   "avg": 0.6,
   "pscore": 8.6,
   "rank": 3
  },
  {
   "id": "GAP-10",
   "title": "No assurance cycle",
   "why": "Certification needs evidence that the ISMS is checked and improved. With no audit, review or corrective action, Stage 2 cannot pass.",
   "what": "Set KPIs, audit in July 2027, hold management review in August 2027 and close actions.",
   "owner": "Eglė Norvilaitė",
   "target": "Aug 2027",
   "items": 10,
   "p1": 4,
   "avg": 0.4,
   "pscore": 8.2,
   "rank": 4
  },
  {
   "id": "GAP-07",
   "title": "Recovery is unproven",
   "why": "If backups fail or are deleted, Orvanta may be unable to restore ledgers, risking customer funds records and its license standing.",
   "what": "Isolate backups, test restores every quarter, and complete a BIA with recovery objectives.",
   "owner": "Rashad Guliyev",
   "target": "May 2027",
   "items": 3,
   "p1": 2,
   "avg": 1,
   "pscore": 8,
   "rank": 5
  },
  {
   "id": "GAP-03",
   "title": "Identity and privileged access are too open",
   "why": "One stolen password could give an attacker control of production, customer data and the payment flow, with shared accounts hiding who acted.",
   "what": "Remove shared accounts, close five MFA gaps, cut standing admin rights and deprovision within 24 hours.",
   "owner": "Rashad Guliyev",
   "target": "Apr 2027",
   "items": 12,
   "p1": 7,
   "avg": 1.25,
   "pscore": 7.66666666666667,
   "rank": 6
  },
  {
   "id": "GAP-06",
   "title": "Incident response is untested",
   "why": "In a real attack, confused decisions could prolong outages and put regulatory notification duties at risk.",
   "what": "Approve a plan and two playbooks, then run a tabletop exercise.",
   "owner": "Nino Beridze",
   "target": "May 2027",
   "items": 6,
   "p1": 3,
   "avg": 1,
   "pscore": 7.66666666666667,
   "rank": 7
  },
  {
   "id": "GAP-04",
   "title": "Sensitive data and endpoints are exposed",
   "why": "Card numbers in tickets, 43 unmanaged laptops and undocumented Baku data access create breach, PCI DSS and GDPR exposure.",
   "what": "Purge card data, enroll all laptops, mask data and complete the transfer assessment.",
   "owner": "Farid Ismayilov",
   "target": "May 2027",
   "items": 16,
   "p1": 7,
   "avg": 1.1875,
   "pscore": 7.125,
   "rank": 8
  },
  {
   "id": "GAP-01",
   "title": "No ISMS foundation",
   "why": "Without an approved scope, policy and objectives, no auditor can begin certification, so EUR 2.4M of enterprise revenue stays out of reach.",
   "what": "Approve scope, policy, roles and objectives in the first 90 days.",
   "owner": "Nino Beridze",
   "target": "Feb 2027",
   "items": 22,
   "p1": 2,
   "avg": 1,
   "pscore": 6.81818181818182,
   "rank": 9
  },
  {
   "id": "GAP-09",
   "title": "Change control can be bypassed",
   "why": "A compromised or rushed change can reach the payment platform unreviewed, causing outages or fraud. 14% of Q3 2026 deployments bypassed review.",
   "what": "Protect all production repositories, enforce the CI path and add security gates.",
   "owner": "Tural Mammadli",
